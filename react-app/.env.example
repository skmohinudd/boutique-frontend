VITE_APP_NAME=Boutique
VITE_APP_ENV=dev

VITE_PRODUCT_API_URL=/product-api
VITE_INVENTORY_API_URL=/inventory-api
VITE_USER_API_URL=/user-api
VITE_CART_API_URL=/cart-api
VITE_ORDER_API_URL=/order-api
VITE_PAYMENT_API_URL=/payment-api
VITE_CHECKOUT_API_URL=/checkout-api
VITE_SHIPPING_API_URL=/shipping-api
VITE_API_TIMEOUT_MS=15000
VITE_DEFAULT_CURRENCY=USD

# Cognito SPA / Authorization Code + PKCE
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_L1JgwXP8B
VITE_COGNITO_CLIENT_ID=5vod13me82da460ko5gvep3ov5
VITE_COGNITO_DOMAIN=https://us-east-1l1jgwxp8b.auth.us-east-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/
VITE_COGNITO_LOGOUT_URI=http://localhost:5173/
VITE_COGNITO_SCOPE=openid email

# Local Vite proxy targets. The Boutique dev backends run behind the AWS ALB/Ingress, not on laptop ports.
VITE_PRODUCT_SERVICE_TARGET=https://api.needystuff.in
VITE_INVENTORY_SERVICE_TARGET=https://api.needystuff.in
VITE_USER_SERVICE_TARGET=https://api.needystuff.in
VITE_CART_SERVICE_TARGET=https://api.needystuff.in
VITE_ORDER_SERVICE_TARGET=https://api.needystuff.in
VITE_PAYMENT_SERVICE_TARGET=https://api.needystuff.in
VITE_CHECKOUT_SERVICE_TARGET=https://api.needystuff.in
VITE_SHIPPING_SERVICE_TARGET=https://api.needystuff.in

VITE_ENABLE_ADVERTISEMENTS=true
VITE_ENABLE_RECOMMENDATIONS=true
